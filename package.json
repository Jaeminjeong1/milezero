{
  "name": "milezero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server/main.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "dev:client": "vite",
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/main.js",
    "qa:demo": "tsx src/demo/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "latest",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "latest",
    "fastify": "^5.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "latest",
    "vite": "^8.2.1",
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.19.0"
}
