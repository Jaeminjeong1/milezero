{
  "name": "@milezero/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server/main.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "dev": "tsx watch src/server/main.ts",
    "dev:demo": "cross-env MILEZERO_MODE=demo tsx watch src/server/main.ts",
    "start": "node dist/main.js",
    "qa:demo": "tsx src/demo/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "latest",
    "@supabase/supabase-js": "latest",
    "fastify": "^5.11.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "latest",
    "cross-env": "^10.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
